<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="dbup-core" Version="6.1.1" />
        <PackageReference Include="dbup-postgresql" Version="7.0.1" />
        <PackageReference Include="dbup-sqlite" Version="6.0.4" />
        <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.9" />
        <PackageReference Include="Npgsql" Version="10.0.3" />
        <PackageReference Include="SourceGear.sqlite3" Version="3.53.3" />
        <PackageReference Include="SQLitePCLRaw.config.e_sqlite3" Version="3.0.3" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Scripts/**/*.sql" />
    </ItemGroup>

</Project>
