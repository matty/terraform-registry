<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AWSSDK.S3" Version="4.0.100.3" />
        <PackageReference Include="coverlet.collector" Version="6.0.4" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
        <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.9" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="SourceGear.sqlite3" Version="3.53.3" />
        <PackageReference Include="SQLitePCLRaw.config.e_sqlite3" Version="3.0.3" />
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="Xunit.Extensions.Logging" Version="1.1.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
        <PackageReference Include="Moq" Version="4.20.72" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TerraformRegistry\TerraformRegistry.csproj" />
        <ProjectReference Include="..\TerraformRegistry.API\TerraformRegistry.API.csproj" />
        <ProjectReference Include="..\TerraformRegistry.PostgreSQL\TerraformRegistry.PostgreSQL.csproj" />
        <ProjectReference Include="..\TerraformRegistry.AzureBlob\TerraformRegistry.AzureBlob.csproj" />
        <ProjectReference Include="..\TerraformRegistry.S3\TerraformRegistry.S3.csproj" />
        <ProjectReference Include="..\TerraformRegistry.Migrations\TerraformRegistry.Migrations.csproj" />
